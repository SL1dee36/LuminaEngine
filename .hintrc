{
  "extends": [
    "development"
  ],
  "hints": {
    "meta-viewport": "off",
    "no-inline-styles": "off",
    "disown-opener": "off",
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "script[type=importmap]"
        ]
      }
    ],
    "compat-api/css": "off",
    "axe/forms": "off"
  }
}